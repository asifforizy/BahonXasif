model Organization {
  id        String             @id @default(uuid())
  name      String
  code      String             @unique
  email     String?
  phone     String?
  address   String?
  status    OrganizationStatus @default(ACTIVE)

  users     User[]
  hubs      Hub[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("organizations")
}