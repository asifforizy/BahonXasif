model Hub {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  code           String    @unique
  address        String?
  city           String?
  zone           String?
  status         HubStatus @default(ACTIVE)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  managers HubManager[]

  originShipments      Shipment[] @relation("OriginHub")
  destinationShipments Shipment[] @relation("DestinationHub")

  statusHistory ShipmentStatusHistory[]

  outgoingTransfers HubTransfer[] @relation("FromHub")
  incomingTransfers HubTransfer[] @relation("ToHub")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([city])
  @@index([zone])
  @@index([status])
  @@map("hubs")
}